---
import { getCollection, render } from "astro:content";
import LegalLayout from "../../layouts/LegalLayout.astro";
const entry = (await getCollection("legal")).find(({data}) => data.path === "/terms-of-use/");
if (!entry) throw new Error("Missing preserved terms and conditions");
const { Content } = await render(entry);
---
<LegalLayout {...entry.data}><Content /></LegalLayout>
