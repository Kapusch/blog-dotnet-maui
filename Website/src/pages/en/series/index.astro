---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout locale="en" title="Series" description="Guided learning paths from MAUI, c’est clair!" path="/en/series/" alternatePath="/series/">
  <header class="page-hero container"><p class="eyebrow">Guided paths</p><h1>Learn for the long run</h1><p class="lead">Series keep context visible and advance a real application from one chapter to the next.</p></header>
  <section class="series-link container"><a href="/en/posts/tutos/my-first-app/"><span>15 chapters</span><h2>My first app</h2><p>Build and publish a complete .NET MAUI application.</p><strong>Explore the course →</strong></a></section>
</BaseLayout>
<style>.series-link{padding-bottom:7rem}.series-link a{display:block;padding:clamp(1.6rem,5vw,3rem);border:1px solid #d2c9f3;border-radius:var(--radius-lg);background:linear-gradient(135deg,var(--accent-soft),white 75%);color:var(--ink);text-decoration:none}.series-link span{color:var(--accent);font:750 .75rem ui-monospace,monospace;text-transform:uppercase}.series-link h2{margin:.8rem 0;font-size:clamp(2rem,5vw,3.5rem)}.series-link p{color:var(--muted);font-size:1.08rem}.series-link strong{display:block;margin-top:1.5rem;color:var(--accent)}</style>
