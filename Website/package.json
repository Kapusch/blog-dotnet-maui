{
  "name": "maui-cest-clair-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:prepare": "node scripts/prepare-content.mjs",
    "predev": "npm run content:prepare",
    "dev": "astro dev",
    "prebuild": "npm run content:prepare",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "precheck": "npm run content:prepare",
    "check": "astro check",
    "validate": "node scripts/verify-build.mjs",
    "test": "npm run check && npm run build && npm run validate"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@expressive-code/plugin-line-numbers": "0.44.1",
    "astro": "7.2.1",
    "astro-expressive-code": "0.44.1",
    "pagefind": "1.5.2",
    "typescript": "^5.9.3",
    "yaml": "2.9.0"
  }
}
